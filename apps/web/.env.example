# Relative database paths resolve from the repository root. Persist this path on the server.
# All clients use the same server/account.
FILETASKS_DATABASE_PATH=./data/filetasks.sqlite
# Set this to the public HTTPS URL behind a reverse proxy.
# FILETASKS_ORIGIN=https://filetasks.example.com
# Optional public URL used for calendar backlinks; defaults to FILETASKS_ORIGIN.
# FILETASKS_PUBLIC_URL=https://filetasks.example.com
# A private 32-byte key used to encrypt connected calendar credentials. Generate with: openssl rand -base64 32
# FILETASKS_CALENDAR_ENCRYPTION_KEY=base64-encoded-32-byte-key
# Google Calendar OAuth settings. Configure the callback URL as /api/calendars/google/callback.
# GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_CALENDAR_REDIRECT_URI=https://filetasks.example.com/api/calendars/google/callback
# FILETASKS_TIME_ZONE=Europe/London
# Reminder delivery worker. Schedule POST /api/internal/reminders/deliver once per minute with
# Authorization: Bearer <secret>. Delivery URLs implement the adapter contract in docs/api.md.
# FILETASKS_REMINDER_WORKER_SECRET=long-random-secret
# FILETASKS_EMAIL_DELIVERY_URL=https://delivery.example.com/filetasks
# FILETASKS_EMAIL_DELIVERY_TOKEN=server-only-token
# FILETASKS_PUSH_DELIVERY_URL=https://push.example.com/filetasks
# FILETASKS_PUSH_DELIVERY_TOKEN=server-only-token
# Web Push requires the matching VAPID public key in the client build and private key at the push adapter.
# NEXT_PUBLIC_FILETASKS_VAPID_PUBLIC_KEY=base64url-public-key
# Cloudflare R2 credentials are server-only. Uploads remain unavailable until these are set.
# FILETASKS_R2_ACCOUNT_ID=your-account-id
# FILETASKS_R2_ACCESS_KEY_ID=your-r2-access-key-id
# FILETASKS_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# FILETASKS_R2_BUCKET=filetasks-private
# Optional S3-compatible endpoint override for local development.
# FILETASKS_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
