# Relative database paths resolve from the repository root. Persist this path on the server.
# All clients use the same server/account.
FILETASKS_DATABASE_PATH=./data/filetasks.sqlite
# Set this to the public HTTPS URL behind a reverse proxy.
# FILETASKS_ORIGIN=https://filetasks.example.com
# Cloudflare R2 credentials are server-only. Uploads remain unavailable until these are set.
# FILETASKS_R2_ACCOUNT_ID=your-account-id
# FILETASKS_R2_ACCESS_KEY_ID=your-r2-access-key-id
# FILETASKS_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# FILETASKS_R2_BUCKET=filetasks-private
# Optional S3-compatible endpoint override for local development.
# FILETASKS_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
